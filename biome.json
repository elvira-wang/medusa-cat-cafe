{
  "$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
  "vcs": {
    "clientKind": "git"
  },
  "files": {
    "includes": [
      "**/*.{ts}",
      "!.log",
      "!.medusa",
      "!.turbo",
      "!.vscode",
      "!node_modules"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      },
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedFunctionParameters": "off"
      },
      "style": {
        "noUnusedTemplateLiteral": "off"
      }
    },
    "includes": [
      "**/*.{js,jsx,ts,tsx}",
      "!.next/**",
      "!out/**",
      "!build/**",
      "!next-env.d.ts"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "quoteProperties": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "overrides": [
    {
      "includes": ["**/*.{js,jsx,ts,tsx}"],
      "linter": {
        "rules": {
          "correctness": {
            "noChildrenProp": "error",
            "noUnusedImports": "off",
            "useExhaustiveDependencies": "warn",
            "useHookAtTopLevel": "error",
            "useJsxKeyInIterable": "error"
          },
          "suspicious": {
            "noCommentText": "error",
            "noDuplicateJsxProps": "error"
          },
          "security": {
            "noDangerouslySetInnerHtmlWithChildren": "error"
          },
          "a11y": {
            "noSvgWithoutTitle": "off",
            "useAriaPropsForRole": "warn",
            "useValidAriaProps": "warn"
          }
        }
      }
    }
  ]
}
